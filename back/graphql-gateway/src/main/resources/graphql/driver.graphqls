# What the drivers send from their phone (PWA or Android app) and what they are told, plus what the fleet managers
# see of it. Records sent by the phone carry an id generated on the phone: sending them again after a network failure
# returns the record already stored.

enum FuelKind { FUEL CHARGE }
enum FuelPayment { FUEL_CARD PERSONAL }
enum InspectionKind { PICKUP RETURN PERIODIC }
enum InspectionItem { BODYWORK WINDSCREEN TYRES LIGHTS INTERIOR CLEANLINESS SAFETY_KIT DOCUMENTS }
enum InspectionCondition { OK DAMAGED MISSING }
enum NotificationKind { DEADLINE VEHICLE_ALERT INCIDENT }
enum NotificationLevel { INFO WARNING CRITICAL }

extend type Query {
  "Driver role: my last 50 fill-ups and charges."
  myFuelEntries: [FuelEntry!]!
  "Driver role: my last 20 inspections."
  myInspections: [Inspection!]!
  "Driver role: deadlines due within 30 days or overdue, alerts of my vehicle, progress of my claims."
  myNotifications: [DriverNotification!]!
  "Approved garages near a point, nearest first."
  nearbyGarages(latitude: Float!, longitude: Float!, radiusKm: Int = 25, limit: Int = 20): [NearbyGarage!]!
}

extend type Mutation {
  "Driver role: enter a fill-up or a charge. The id is generated by the phone."
  recordMyFuel(id: ID!, input: RecordFuelInput!): FuelEntry!
  "Driver role: record an inspection of my vehicle. The id is generated by the phone."
  recordMyInspection(id: ID!, input: RecordInspectionInput!): Inspection!
  "Driver role: declare a claim with an id generated by the phone (photos are then sent to the REST API)."
  declareMyIncidentWithId(id: ID!, input: DeclareIncidentInput!): Incident!
}

extend type Vehicle {
  "Fill-ups and charges entered by its drivers (last 50)."
  fuelEntries: [FuelEntry!]!
  "Inspections by its drivers (last 20)."
  inspections: [Inspection!]!
}

extend type Incident {
  "Photos taken by the driver; the image is at /api/v1/photos/{id}."
  photos: [Photo!]!
}

type FuelEntry {
  id: ID!
  vehicleId: ID!
  driver: DriverRef
  filledAt: DateTime!
  kind: FuelKind!
  "Litres, or kWh for a charge."
  quantity: Float!
  amount: Float!
  "Price per litre or per kWh."
  unitPrice: Float!
  mileage: Int!
  station: String
  payment: FuelPayment!
  createdAt: DateTime!
}

type Inspection {
  id: ID!
  vehicleId: ID!
  driver: DriverRef
  kind: InspectionKind!
  performedAt: DateTime!
  mileage: Int!
  "Fuel or battery level, in percent."
  fuelLevel: Int!
  remarks: String
  checks: [InspectionCheck!]!
  "Points found damaged or missing."
  defects: Int!
  photos: [Photo!]!
  createdAt: DateTime!
}

type InspectionCheck {
  item: InspectionItem!
  condition: InspectionCondition!
  comment: String
}

type Photo {
  id: ID!
  contentType: String!
  sizeBytes: Int!
  createdAt: DateTime!
}

type DriverNotification {
  "Stable while nothing changes: the phone notifies once per id."
  id: ID!
  kind: NotificationKind!
  level: NotificationLevel!
  "Deadline type, alert type or claim status."
  code: String!
  "Text of the alert, urgency of the deadline or reference of the claim."
  detail: String
  dueDate: Date
  dueMileage: Int
  at: DateTime!
}

type NearbyGarage {
  id: ID!
  name: String!
  network: GarageNetwork!
  brand: String
  address: String
  postalCode: String
  city: String!
  phone: String
  hourlyRate: Float
  rating: Float
  latitude: Float
  longitude: Float
  "As the crow flies, in kilometres."
  distanceKm: Float!
}

input RecordFuelInput {
  filledAt: DateTime!
  kind: FuelKind!
  quantity: Float!
  amount: Float!
  mileage: Int!
  station: String
  payment: FuelPayment!
}

input RecordInspectionInput {
  kind: InspectionKind!
  performedAt: DateTime!
  mileage: Int!
  fuelLevel: Int!
  remarks: String
  checks: [InspectionCheckInput!]!
}

input InspectionCheckInput {
  item: InspectionItem!
  condition: InspectionCondition!
  comment: String
}
