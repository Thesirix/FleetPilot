<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fleetpilot</groupId>
        <artifactId>fleetpilot-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>acceptance-tests</artifactId>
    <name>FleetPilot :: End-to-end acceptance tests</name>
    <description>Business scenarios in French (Cucumber) played in a real browser with Selenium WebDriver against the
        running platform: web portal, driver space and lessor extranet. They need "docker compose up" first, so they
        only run on demand: ./mvnw -pl acceptance-tests verify -De2e</description>

    <properties>
        <selenium.version>4.51.0</selenium.version>
        <!-- Skipped in the normal build: the platform must be running -->
        <skipE2e>true</skipE2e>
    </properties>

    <profiles>
        <profile>
            <id>e2e</id>
            <activation>
                <property>
                    <name>e2e</name>
                </property>
            </activation>
            <properties>
                <skipE2e>false</skipE2e>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- One browser per scenario, shared by the step classes -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The HTML report of Cucumber is written with Jackson -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <skipITs>${skipE2e}</skipITs>
                    <systemPropertyVariables>
                        <cucumber.plugin>pretty, html:target/cucumber/report.html, junit:target/cucumber/junit.xml</cucumber.plugin>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
