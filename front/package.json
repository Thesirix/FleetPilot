{
  "name": "fleetpilot-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FleetPilot web portal: fleet managers, FleetPilot staff, garages and drivers (PWA).",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "test": "node -e \"require('fs').rmSync('node_modules/.vitest-cache',{recursive:true,force:true})\" && vitest run",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "generate-pwa-assets": "pwa-assets-generator",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "1.0.3",
    "@vite-pwa/nuxt": "1.1.1",
    "echarts": "6.1.0",
    "leaflet": "1.9.4",
    "lucide-vue-next": "1.0.0",
    "nuxt": "4.6.1",
    "oidc-client-ts": "3.5.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-echarts": "8.3.2",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.3.3",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "1.9.20",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vue/test-utils": "2.5.1",
    "cypress": "16.2.0",
    "happy-dom": "21.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "cypress@16.2.0": true
  }
}
